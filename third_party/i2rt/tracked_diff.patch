+        ) -> None:
+            del motor_list
+            self.motor_offset = np.asarray(motor_offset, dtype=float)
+            self.motor_direction = np.asarray(motor_direction, dtype=float)
+            self.channel = channel
+            observed[f"{channel}_offset"] = self.motor_offset.copy()
+
+        def read_states(self) -> list[SimpleNamespace]:
+            corrected = (raw_positions - self.motor_offset) * self.motor_direction
+            return [SimpleNamespace(pos=value) for value in corrected]
+
+        def send_commands_once(
+            self,
+            *,
+            pos: np.ndarray,
+            **_: object,
+        ) -> None:
+            observed[f"{self.channel}_hold_joint"] = pos.copy()
+            observed[f"{self.channel}_hold_raw"] = (
+                pos * self.motor_direction + self.motor_offset
+            )
+
+        def start_thread(self) -> None:
+            pass
+
+        def close(self) -> None:
+            pass
+
+    monkeypatch.setattr(get_robot_module, "DMChainCanInterface", RecordingMotorChain)
