+def parse_joint_target_degrees(text: str, joint_ranges_deg: Sequence[tuple[float, float]]) -> np.ndarray:
+    """Parse a comma- or whitespace-separated joint target in degrees."""
+    try:
+        target = np.asarray([float(token) for token in text.replace(",", " ").split()], dtype=float)
+    except ValueError as exc:
+        raise ValueError("joint angles must be finite numbers") from exc
+    expected_count = len(joint_ranges_deg)
+    if target.size != expected_count:
+        raise ValueError(f"expected {expected_count} joint angles, got {target.size}")
+    if not np.all(np.isfinite(target)):
+        raise ValueError("joint angles must be finite numbers")
+    for index, (angle, (lo, hi)) in enumerate(zip(target, joint_ranges_deg, strict=True), start=1):
+        if angle < lo or angle > hi:
+            raise ValueError(f"j{index} must be between {lo:.1f} and {hi:.1f} deg")
+    return target
+
